# IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
# Anchored on purpose. A bare `build/` also matches the Imagi "build" product
# (frontend/vuejs/src/apps/imagi/build/), which is source, not an artifact.
# Un-ignoring it with `!` satisfies git but NOT ripgrep, which drops the whole
# directory when it reads this file as a *parent* ignore — so `rg` run from
# frontend/vuejs/ finds none of those 48 files.
/build/
backend/django/build/
.venv/
venv/

# Django
backend/django/db.sqlite3
backend/django/db.sqlite3-journal
# WAL mode's side files — they appear next to the dev DB whenever it is served.
backend/django/db.sqlite3-wal
backend/django/db.sqlite3-shm
backend/django/media/
backend/django/staticfiles/
backend/django/apps/Imagi/Build/imagi_projects/
backend/django/apps/Imagi/Build/imagi_frontend_deps/

# Node / Vue
frontend/vuejs/node_modules/
frontend/vuejs/dist/
frontend/vuejs/coverage/
*.local
*.tsbuildinfo
.eslintcache
dist-ssr
*.timestamp-*-*.mjs
