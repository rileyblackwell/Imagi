# OS
.DS_Store
Thumbs.db

# Environment variables
.env
.env.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Claude Code dev-setup artifacts
.claude/.locks/
.claude/.dev-setup.log
